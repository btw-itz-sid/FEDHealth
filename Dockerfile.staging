FROM node:22-bookworm-slim AS api-build
WORKDIR /build
COPY backend/api/package*.json ./
RUN npm ci
COPY backend/api/tsconfig*.json backend/api/nest-cli.json ./
COPY backend/api/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim AS web-build
WORKDIR /build
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libstdc++6 && rm -rf /var/lib/apt/lists/*
COPY --from=api-build /usr/local/bin/node /usr/local/bin/node
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NODE_ENV=production \
    SERVE_FRONTEND=true ARTIFACT_STORAGE=database TRUST_PROXY=1 \
    DATASET_UPLOAD_DIR=/app/data/uploads DATA_DIR=/app/data \
    MODELS_DIR=/app/backend/ml-service/models MODEL_ARTIFACT_DIR=/app/backend/ml-service/models \
    ARTIFACTS_DIR=/app/artifacts MAX_TRAINING_ROWS=2000 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
WORKDIR /app
COPY backend/ml-service/requirements.lock.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt && useradd --uid 1000 --create-home fedhealth && \
    mkdir -p /app/data/uploads /app/backend/ml-service/models /app/artifacts && chown -R fedhealth:fedhealth /app
COPY --from=api-build --chown=fedhealth:fedhealth /build/dist /app/backend/api/dist
COPY --from=api-build --chown=fedhealth:fedhealth /build/node_modules /app/backend/api/node_modules
COPY --from=web-build --chown=fedhealth:fedhealth /build/dist /app/frontend/dist
COPY --chown=fedhealth:fedhealth backend/ml-service/app /app/backend/ml-service/app
USER fedhealth
EXPOSE 10000
CMD ["node", "/app/backend/api/dist/database/start-staging.js"]
