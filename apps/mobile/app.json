{
  "expo": {
    "name": "FedHealth",
    "slug": "fedhealth-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e40af"
    },
    "scheme": "fedhealth",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.fedhealth.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e40af"
      },
      "package": "dev.fedhealth.mobile"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
